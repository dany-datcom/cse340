<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= organizationDetails.name %>
        </h2>

        <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo"
            class="organization-logo">

        <p><strong>Description:</strong>
            <%= organizationDetails.description %>
        </p>

        <h3>Service Projects</h3>

        <ul>
            <% if (projects && projects.length> 0) { %>
                <% projects.forEach(project=> { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </li>
                    <% }) %>
                        <% } else { %>
                            <li>No projects available for this organization.</li>
                            <% } %>
        </ul>

         <% if (isLoggedIn) { %>
            <% if (user.role_name === 'admin') { %>
            <div class="center-buttons">
                <a href="/edit-organization/<%= organizationDetails.organization_id %>" class="btn btn-secondary"> Edit
                    Organization
                </a>
            </div>
            <% } %>
        <% } %>
    </main>

    <%- include('partials/footer') %>