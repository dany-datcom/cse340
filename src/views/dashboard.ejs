<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <section>
        <h2>Dashboard</h2>

        <p><strong>Name:</strong> <%= name %></p>
        <p><strong>Email:</strong> <%= email %></p>
    </section>

    <!-- Admin-only section -->
    <% if (user && user.role_name === 'admin') { %>
        <section>
            <h3>Admin Panel</h3>
            <a href="/users">View All Users</a>
        </section>
    <% } %>

</main>

<%- include('partials/footer') %>