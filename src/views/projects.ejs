<%- include('partials/header') %>

    <main>
        <h2>Upcoming Service Projects</h2>

        <ul>
            <% if (projects && projects.length> 0) { %>
                <% projects.forEach(project=> { %>
                    <li class="project-item">

                        <h3>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h3>

                        <p>
                            <strong>Organization:</strong>
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>

                    </li>
                    <% }) %>
                        <% } else { %>
                            <li>No upcoming projects available.</li>
                            <% } %>
        </ul>

        <% if (isLoggedIn) { %>
            <% if (user.role_name==='admin' ) { %>
                <div class="center-buttons">
                    <a href="/new-project" class="btn btn-secondary">Add a New Service Project</a>
                </div>
            <% } %>
        <% } %>

    </main>

    <%- include('partials/footer') %>