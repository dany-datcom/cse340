<%- include('partials/header') %>

  <main>
    <h1>
      <%= projectDetails.title %>
    </h1>

    <h2>Assign Categories</h2>

    <form action="/assign-categories/<%= projectId %>" method="POST">

      <div class="form-group">
        <% categories.forEach(category=> { %>
          <label class="category-item">
            <input type="checkbox" name="categoryIds" value="<%= category.category_id %>"
              <%=assignedCategories.some(ac=> ac.category_id === category.category_id) ? 'checked' : '' %>
            />
            <span>
              <%= category.name %>
            </span>
          </label>
          <% }); %>
      </div>
       <% if (isLoggedIn) { %>
      <div class="center-buttons">
        <button type="submit" class="btn btn-secondary"> Update Catergories
        </button>
      </div>
        <% } %>

    </form>
  </main>

  <%- include('partials/footer') %>