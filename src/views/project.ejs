<%- include('partials/header') %>

    <main>

        <div class="project-card">

            <h1>
                <%= project.title %>
            </h1>

            <p class="project-description">
                <%= project.description %>
            </p>

            <div class="project-meta">
                <p><strong>Date:</strong>
                    <%= project.date %>
                </p>
                <p><strong>Location:</strong>
                    <%= project.location %>
                </p>
            </div>

            <p>
                <strong>Organization:</strong>
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
            </p>

            <!-- CATEGORIES -->
            <div class="category-tags">
                <h3>Categories:</h3>

                <% if (categories && categories.length> 0) { %>
                    <% categories.forEach(cat=> { %>
                        <a href="/category/<%= cat.category_id %>">
                            <%= cat.name %>
                        </a>
                        <% }) %>
                            <% } else { %>
                                <p>No categories assigned.</p>
                                <% } %>
            </div>

            <!-- ADMIN -->
            <% if (isAdmin) { %>
                <div class="center-buttons">
                    <a href="/assign-categories/<%= project.project_id %>" class="btn btn-secondary">
                        Edit Categories
                    </a>

                    <a href="/edit-project/<%= project.project_id %>" class="btn btn-primary">
                        Edit Project
                    </a>
                </div>
                <% } %>

                    <!-- VOLUNTEER -->
                    <% if (user) { %>

                        <div class="volunteer-section">

                            <% if (!isVolunteer) { %>
                                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                                    <button type="submit" class="btn btn-primary">
                                        Volunteer
                                    </button>
                                </form>
                                <% } else { %>

                                    <p class="volunteer-active">
                                        You are volunteering for this project ✅
                                    </p>

                                    <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                                        <button type="submit" class="btn btn-secondary">
                                            Remove
                                        </button>
                                    </form>

                                    <% } %>

                        </div>

                        <% } %>

        </div>

    </main>

    <%- include('partials/footer') %>