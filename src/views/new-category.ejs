<%- include('partials/header') %>

<main>
    <h1>Create Category</h1>

    <form action="/new-category" method="POST">

        <div class="form-group">
            <label for="name">Category Name</label>
            <input 
                type="text" 
                id="name"
                name="name" 
                required 
                maxlength="100"
                minlength="3"
                autofocus
            >
        </div>

        <button type="submit">Create</button>

    </form>
</main>

<%- include('partials/footer') %>