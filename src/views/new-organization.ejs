<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <form action="/new-organization" method="POST">

        <!-- ORGANIZATION NAME -->
        <div class="form-group">
            <label for="name">Organization Name</label>
            <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                maxlength="150"
                minlength="3"
                autofocus
            />
        </div>

        <!-- DESCRIPTION -->
        <div class="form-group">
            <label for="description">Description</label>
            <textarea 
                id="description" 
                name="description" 
                required 
                maxlength="500"
            ></textarea>
        </div>

        <!-- CONTACT EMAIL -->
        <div class="form-group">
            <label for="contactEmail">Contact Email</label>
            <input 
                type="email" 
                id="contactEmail" 
                name="contactEmail" 
                required
                autocomplete="email"
            />
        </div>
         <% if (isLoggedIn) { %>
            <% if (user.role_name === 'admin') { %>
                <button type="submit">Create Organization</button>
            <% } %>
        <% } %>
    </form>
</main>

<%- include('partials/footer') %>